AGENT_LOOP_NAME="sixtyops-manager"
AGENT_LOOP_REPO_DIR="${AGENT_LOOP_REPO_DIR:-/Users/serveradmin/repos/sixtyops-manager}"
AGENT_LOOP_STATE_DIR="${AGENT_LOOP_STATE_DIR:-$HOME/.local/state/agent-review-loop/sixtyops-manager}"

AGENT_LOOP_READY_LABEL="agent:ready"
AGENT_LOOP_REVIEW_LABEL="agent:review"
AGENT_LOOP_FIX_LABEL="agent:claude"
# The review-fix loop stays off for Manager because the shared script accepts only Claude modes; the lead sends review fixes to new Luna workers; turn the loop on after the shared script accepts the Codex auto-review mode.
AGENT_LOOP_PROVIDER="codex/gpt-6-luna"
AGENT_LOOP_FIX_MODE="off"
AGENT_LOOP_IN_PROGRESS_LABEL="agent:in-progress"
AGENT_LOOP_NEEDS_HUMAN_LABEL="agent:needs-human"

# The review loop uses only Luna: medium for reviews and high for safety paths.
AGENT_LOOP_REVIEWER_PROVIDER="codex/gpt-6-luna"
AGENT_LOOP_REVIEWER_THINKING="medium"
AGENT_LOOP_REVIEWER_SAFETY_PROVIDER="codex/gpt-6-luna"
AGENT_LOOP_REVIEWER_SAFETY_THINKING="high"
# The reviewer uses Luna; these limits apply to reviews only.
AGENT_LOOP_REVIEWER_MAX_DAILY_RUNS=200
AGENT_LOOP_REVIEWER_MAX_HOURLY_RUNS=20
AGENT_LOOP_REVIEWER_COOLDOWN_SECONDS=60
# The reviewer looks only for risks to the device fleet. This list replaces the
# shared focus list of the reviewer prompt. Single-quoted: literal prompt text.
AGENT_LOOP_REVIEW_FOCUS='Review ONLY the safety of managing hardware at scale. Report a finding only when the change can harm devices, the fleet, or the service of customers:
- Blast radius: a change that can touch more devices than intended. Examples: a wrong device selector, an empty filter that selects all devices, a larger wave or batch, or more concurrent device writes.
- Rollout gate: a change that bypasses or weakens updater/rollout_gate.py, tests/test_rollout_invariants.py, the one-wave-per-maintenance-window rule, or the halt when a device does not come back online.
- Device writes: a firmware push, configuration push, or reboot with no pre-check, no read-back, or no rollback path. A write that is not idempotent when the loop retries it.
- Bricking risk: no check that the firmware image matches the device model and hardware, a firmware downgrade, or a missing signature, checksum, or trusted-key check.
- Failure handling at the device boundary: a timeout, retry, or partial failure that the code counts as a success. A retry storm that can overload devices or the network.
- Scheduling and concurrency: a job that can run twice, a missing lock, or a race that can reboot or update the same device again.
- Device credentials and trust: a device or RADIUS credential that reaches a log or a response, or TLS verification that is off for a device connection.
- Device inventory data: a migration, import, or backup change that can lose devices, assign a device to the wrong site, or target the wrong device.
- Missing tests for a new safety behavior or a changed safety invariant in the items above.
Do NOT report style, naming, refactoring, documentation drift, UI text, or general code quality. A change with no fleet-safety risk gets NO findings.'
# These paths cover the rollout engine, device writes, authentication,
# storage, installation, releases, and their safety checks.
AGENT_LOOP_SAFETY_PATHS="updater/app.py,updater/main.py,updater/core/**,updater/scheduler.py,updater/rollout_gate.py,updater/poller.py,updater/models.py,updater/api/**,updater/tachyon.py,updater/vendors/**,updater/device/**,updater/auth.py,updater/oidc_config.py,updater/crypto.py,updater/radius*.py,updater/database.py,updater/db/**,updater/migrations/**,migrations/**,updater/backup.py,updater/bridge_import.py,updater/sftp_backup.py,updater/config/**,updater/config_utils.py,updater/firmware_*.py,updater/release_checker.py,updater/trusted_keys/**,scripts/install.sh,scripts/validate_release.py,entrypoint.sh,Dockerfile*,docker-compose*.yml,.github/workflows/release.yml,.github/workflows/dev-hardware.yml,tests/integration/**,tests/test_rollout_invariants.py,tests/test_strict_smoke_canary.py,updater/services.py,updater/templates/monitor.html,updater/static/js/rollout*.js"

# Operator GitHub login. The review-fix and codex-review loops assign this login
# to a pull request (PR) that gets the label agent:needs-human, and remove the
# assignment when the PR goes back to an automated label. This makes
# `is:open assignee:<login>` a native action list on GitHub and in the GitHub
# mobile app. Set an operator login here, never a bot login. The login must have
# access to the repository. Empty = no assignment; the loops run normally.
AGENT_LOOP_OPERATOR_LOGIN=""

# Pickup order: higher-priority label first; oldest-first within a tier.
AGENT_LOOP_PRIORITY_LABELS="priority: high,priority: medium,priority: low"

# Driver changes need a device test plan. A merge does not push device changes.
AGENT_LOOP_DEVICE_PLAN_PATHS='^updater/(vendors/|tachyon\.py$)'
AGENT_LOOP_DEVICE_DEPLOY_PATHS=""

# Size budget of one implementation, in changed lines (additions plus
# deletions). One entry for each complexity label; 0 = no budget. A change of
# more than the budget plus 25 percent opens as a draft PR labeled
# agent:needs-human, for a human split decision.
AGENT_LOOP_SIZE_BUDGET="S=200,M=500,L=0"
AGENT_LOOP_HIGH_RISK_PATTERN='^updater/config_utils[.]py$'

# Pacing — documented shared defaults. The real safety boundary is the human
# merge gate (no auto-merge) plus per-PR MAX_FIX_ROUNDS and per-issue
# MAX_PICKUP_ATTEMPTS caps, not the daily rate. Dial per repo, not globally.
AGENT_LOOP_MAX_DAILY_RUNS=50
AGENT_LOOP_MAX_HOURLY_RUNS=1
AGENT_LOOP_MAX_DAILY_PICKUPS=2
AGENT_LOOP_MAX_HOURLY_PICKUPS=1
AGENT_LOOP_COOLDOWN_SECONDS=1200
# The last permitted review round is final (escalate or sign off, never a fix),
# so a cycle uses at most MAX_REVIEW_ROUNDS-1 fix rounds; MAX_FIX_ROUNDS binds
# only when smaller. MAX_REOPENS bounds operator reopens (relabel) per PR.
AGENT_LOOP_MAX_REVIEW_ROUNDS=2
AGENT_LOOP_MAX_FIX_ROUNDS=2
AGENT_LOOP_MAX_REOPENS=2
AGENT_LOOP_MAX_PICKUP_ATTEMPTS=2
# 24/7 — overnight is free queue-draining time; the human merge gate, not
# operator wakefulness, is the safety control. "00:00-00:00" = never quiet.
AGENT_LOOP_QUIET_HOURS="00:00-00:00"

# Hard rules — per-repo blast-radius control, injected into every Claude prompt.
# Passed verbatim to add-adapter.sh; the operator's explicit decision.
# Single-quoted on purpose: this file is sourced, and the rules are literal
# policy text, never something the shell should expand.
AGENT_LOOP_REPO_RULES='Follow AGENTS.md. Branch from main and target main. Never push directly to main. One feature per branch and PR, with a conventional-commit PR title. Update the CHANGELOG.md Unreleased section for a user-facing change. Run pytest -v before you commit; all tests must pass. Never commit secrets or credentials. Do not run the integration tests in tests/integration, and do not touch live hardware, a dev host, or a production install. Do not create, move, or push a release tag, bump the release version, or run the Release workflow; release tags must be GPG-signed by the release key. Keep main stable, because scripts/install.sh always pulls main. Fleet rollouts advance one wave per maintenance window and halt if a device does not come back online: never bypass updater/rollout_gate.py or weaken tests/test_rollout_invariants.py. Do not merge. Stop for human review when the issue needs hardware, a release, or a production change.'
